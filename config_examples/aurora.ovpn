# =====================================================================
#  Modele de configuration OpenVPN pour AuroraVPN
#  Placer ce fichier ainsi que ca.crt / client.crt / client.key / ta.key
#  dans le meme dossier puis lancer :
#    openvpn.exe --config aurora.ovpn
# =====================================================================

client
dev tun
remote vpn-fr-par-01.aurora.example.com 1194 udp
remote vpn-fr-par-01.aurora.example.com 443  tcp   ; fallback anti-DPI

# Resolution DNS persistante apres connexion.
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name "vpn.aurora.example.com" name

# === Suite cryptographique moderne ===
data-ciphers AES-256-GCM:CHACHA20-POLY1305:AES-128-GCM
data-ciphers-fallback AES-256-GCM
auth SHA384

# TLS 1.3 quand disponible.
tls-version-min 1.3 or-highest
tls-cipher TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
tls-ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256

# Authentification HMAC du canal de controle (anti-DoS, anti-fingerprint).
tls-crypt ta.key

# === Materiel cryptographique ===
ca   ca.crt
cert client.crt
key  client.key

# === Resilience ===
ping 15
ping-restart 60
mssfix 1400

# === Logs ===
verb 3
mute 20
